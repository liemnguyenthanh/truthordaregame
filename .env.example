NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate: openssl rand -hex 32. Keep this stable and backed up.
RECOVERY_ENCRYPTION_KEY=
SEPAY_WEBHOOK_API_KEY=
# Exact gateway name in SePay webhook, e.g. MBBank (verify your provider payload).
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Protected reconciliation endpoint; use independent random secret.
CRON_SECRET=
# SePay legacy v1 User API token (numeric IDs matching webhook).
SEPAY_API_TOKEN=
# Personalized AI packs: Gateway key stays server-side.
AI_GATEWAY_API_KEY=
# On Vercel, runtime VERCEL_OIDC_TOKEN may authenticate instead; do not hardcode it.
AI_MODEL=openai/gpt-6-astra
AI_DAILY_LIMIT=3
# Optional verified model prices per 1M tokens; leave blank for unknown/null cost.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_IP_DAILY_LIMIT=6
AI_GLOBAL_DAILY_LIMIT=20
