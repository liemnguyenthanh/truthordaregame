NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
# Project URL, e.g. https://your-project-ref.supabase.co (NOT an API key).
SUPABASE_URL=
# Server only: Supabase secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Generate: openssl rand -hex 32. Keep this stable and backed up.
RECOVERY_ENCRYPTION_KEY=
# SePay Webhooks, NOT Payment Gateway Merchant ID/Secret.
# Generate a random key and enter the same value in SePay webhook API Key settings.
# Webhook URL: https://<project-ref>.supabase.co/functions/v1/sepay-webhook.
# POST / JSON / incoming transfers / payment prefix TOD + 10 alphanumeric characters.
SEPAY_WEBHOOK_API_KEY=
# Exact gateway name in SePay webhook, e.g. MBBank (verify your provider payload).
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Optional for receiving webhooks; required to run the reconciliation endpoint.
# Protected reconciliation endpoint; use independent random secret.
CRON_SECRET=
# SePay legacy v1 User API token (numeric IDs matching webhook).
SEPAY_API_TOKEN=
# Personalized AI packs: Gateway key stays server-side.
AI_GATEWAY_API_KEY=
# On Vercel, runtime VERCEL_OIDC_TOKEN may authenticate instead; do not hardcode it.
AI_MODEL=openai/gpt-6-astra
AI_DAILY_LIMIT=3
# Optional verified model prices per 1M tokens; leave blank for unknown/null cost.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_IP_DAILY_LIMIT=6
AI_GLOBAL_DAILY_LIMIT=20

# Server-only admin login; use at least 16 characters.
ADMIN_PASSWORD=
